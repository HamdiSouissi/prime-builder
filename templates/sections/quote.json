      "settings": {
        "layout": "flex",
        "direction": "column",
        "columns": 1
      },
      "styles": {
        "desktop": {
          "padding": 32,
          "gap": 16,
          "radius": 12,
          "background": "#fff4f1"
        }
      },
      "children": [
        {
          "id": "quote",
