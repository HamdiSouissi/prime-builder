{
  "kind": "page",
  "name": "contact",
  "version": 1,
  "elements": [
    {
      "id": "contact",
      "type": "container",
      "settings": {
        "layout": "flex",
        "direction": "column",
        "columns": 1
      },
      "styles": {
        "desktop": {
          "padding": 32,
          "gap": 16,
          "radius": 12
        }
      },
      "children": [
        {
          "id": "contact-anchor",
          "type": "anchor",
          "settings": {
            "anchor": "contact"
          },
          "styles": {},
          "children": []
        },
        {
          "id": "contact-title",
          "type": "heading",
          "settings": {
            "text": "@pb:templates.copy.contact_title",
            "level": 2
          },
          "styles": {},
          "children": []
        },
        {
          "id": "contact-copy",
          "type": "text",
          "settings": {
            "text": "@pb:templates.copy.contact_text"
          },
          "styles": {},
          "children": []
        },
        {
          "id": "contact-button",
          "type": "button",
          "settings": {
            "text": "@pb:templates.copy.contact_button",
            "url": "mailto:bonjour@example.com"
          },
          "styles": {},
          "children": []
        }
      ]
    },
    {
      "id": "image-text",
      "type": "container",
      "settings": {
        "layout": "flex",
        "direction": "column",
        "columns": 1
      },
      "styles": {
        "desktop": {
          "padding": 32,
          "gap": 16,
          "radius": 12
        }
      },
      "children": [
        {
          "id": "image-text-art",
          "type": "image",
          "settings": {
            "url": "/assets/plugins/prime-builder/images/landscape.svg",
            "alt": "@pb:templates.copy.image_alt",
            "width": 960,
            "height": 640
          },
          "styles": {},
          "children": []
        },
        {
          "id": "image-text-title",
          "type": "heading",
          "settings": {
            "text": "@pb:templates.copy.about_title",
            "level": 2
          },
          "styles": {},
          "children": []
        },
        {
          "id": "image-text-copy",
          "type": "text",
          "settings": {
            "text": "@pb:templates.copy.about_text"
          },
          "styles": {},
          "children": []
        }
      ]
    }
  ]
}
